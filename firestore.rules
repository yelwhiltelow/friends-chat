rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // config.js의 cloudName과 똑같이 변경하세요 (영문/숫자/밑줄/하이픈).
    function validImage(url) {
      return url == '' || url.matches('https://res[.]cloudinary[.]com/fpvjrdlp/image/upload/[A-Za-z0-9_./,-]+');
    }
    match /rooms/public/messages/{messageId} {
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow get: if false;
      allow create: if request.resource.data.keys().hasAll(['nickname','senderId','text','imageUrl','createdAt'])
        && request.resource.data.keys().hasOnly(['nickname','senderId','text','imageUrl','createdAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.senderId is string
        && request.resource.data.senderId.matches('[a-f0-9-]{36}')
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 1000
        && validImage(request.resource.data.imageUrl)
        && (request.resource.data.text.size() > 0 || request.resource.data.imageUrl.size() > 0)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
